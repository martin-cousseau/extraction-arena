# Frontend (Vite reads these from frontend/.env). The VITE_ prefix is required.
# Native LlamaParse uses LLAMA_CLOUD_API_KEY on the backend, not a VITE_ variable.
# Vision keys are forwarded through /api/llm (those providers omit CORS).
#
# VITE_OPENAI_API_KEY is also used by Analyze with judge (gpt-5.4-mini) on a
# completed run. Not required for LlamaParse extract + deterministic scoring.
VITE_ZAI_API_KEY=your_zai_key_here
VITE_OPENAI_API_KEY=sk-your_openai_key_here
VITE_XAI_API_KEY=xai-your_xai_key_here
