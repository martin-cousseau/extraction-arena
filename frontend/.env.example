# Frontend (Vite reads these from frontend/.env). The VITE_ prefix is required.
# These keys are only used by the deprecated vision adapters (GLM / GPT / Grok)
# and are forwarded through /api/llm. The native DocAI pipeline uses
# LLAMA_CLOUD_API_KEY on the backend (.env), not a VITE_ variable.
VITE_ZAI_API_KEY=your_zai_key_here
VITE_OPENAI_API_KEY=sk-your_openai_key_here
VITE_XAI_API_KEY=xai-your_xai_key_here
