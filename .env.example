# Copy this file to ".env" and fill in your real keys, then run:
#   cp .env.example .env && docker compose up --build
#
# Native DocAI pipeline (LlamaExtract) — backend only, never VITE_.
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_PROJECT_ID=
#
# Deprecated vision adapters (baked into the frontend at Docker build time).
VITE_ZAI_API_KEY=your_zai_key_here
VITE_OPENAI_API_KEY=sk-your_openai_key_here
VITE_XAI_API_KEY=xai-your_xai_key_here
