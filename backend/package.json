    "express": "^4.19.2",
    "multer": "^2.0.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3"
  }
