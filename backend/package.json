{
  "name": "extraction-arena-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PDF to PNG conversion (300 DPI) plus vision-model pass-through proxy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
